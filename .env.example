# Copy this file to .env and put your Groq key in it:
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# Everything here is optional. Without a key the agent is rule-based and fully free.
# The key is read on the server only and is never sent to the browser.

# Your key from https://console.groq.com/keys
GROQ_API_KEY=

# Any model on Groq that supports tool use. Groq retired llama-3.3-70b-versatile for
# free and developer tiers on 16 Aug 2026, so check console.groq.com for the current
# list and set this if the default below is gone.
GROQ_MODEL=openai/gpt-oss-120b
